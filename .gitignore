# Go
/data/
*.db
*.db-shm
*.db-wal

# Node
webui/node_modules/
webui/dist/

# IDE
.idea/
docs/superpowers
webui/docs/
.playwright-mcp
*.iml
.scout
node_modules

# Build
/dist/

# Env
.env

# API key secrets (referenced from config.yaml via @<file>)
FanartApiKey.api.key
TheAudioDBApiKey.api.key

# SPA embedded files (rebuilt from webui/)
app/spa/files/ui/*
!app/spa/files/ui/.gitkeep

# Generated cover art test samples
libs/covergen/testdata/*.png
libs/covergen/allstyles/testdata/text/*.png
.tokensave

# Subagent-driven-development scratch workspace
.superpowers/

libs/covergen/svg/candidates/*
!libs/covergen/svg/candidates/.gitkeep

# Local dev music library, scanned by `make run` (see zarf/localdata/config.yaml)
zarf/locallibrary/*
!zarf/locallibrary/.gitkeep

# Local dev config + data dir used by `make run`; only the config is tracked
zarf/localdata/*
!zarf/localdata/config.yaml
