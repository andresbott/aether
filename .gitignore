# Go
/data/
/server/data/
*.db
*.db-shm
*.db-wal

# Node
webui/node_modules/
webui/dist/

# IDE
.idea/
docs/superpowers
webui/docs/
.playwright-mcp
*.iml
.scout
node_modules

# Build
/dist/

# Hugo site output (make site-build) and resource cache
/site/public/
/site/resources/
/site/.hugo_build.lock

# Env
.env

# API key secrets (referenced from config.yaml via @<file>)
FanartApiKey.api.key
TheAudioDBApiKey.api.key

# SPA embedded files (rebuilt from webui/)
server/app/spa/files/ui/*
!server/app/spa/files/ui/.gitkeep

# Generated cover art test samples
server/libs/covergen/testdata/*.png
server/libs/covergen/allstyles/testdata/text/*.png
.tokensave

# Subagent-driven-development scratch workspace
.superpowers/

server/libs/covergen/svg/candidates/*
!server/libs/covergen/svg/candidates/.gitkeep

# Local dev music library, scanned by `make run` (see server/zarf/localdata/config.yaml)
server/zarf/locallibrary/*
!server/zarf/locallibrary/.gitkeep

# Local dev config + data dir used by `make run`; only the config is tracked
server/zarf/localdata/*
!server/zarf/localdata/config.yaml
